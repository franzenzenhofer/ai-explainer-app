---
import '../styles/global.css'
import { DEFAULT_INPUT_TEXT, STORAGE_KEY } from '../store/appStore'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline define:vars={{ defaultText: DEFAULT_INPUT_TEXT, storageKey: STORAGE_KEY }}>
      // A returning reader with their own saved prompt: the server HTML shows the default text, so the
      // slide body stays hidden until React has restored the saved one (html[data-ready]). No swap is seen.
      try {
        var saved = JSON.parse(localStorage.getItem(storageKey) || 'null')
        var text = saved && saved.state && saved.state.inputText
        if (typeof text === 'string' && text !== defaultText) document.documentElement.dataset.restore = 'true'
      } catch (error) {
        console.warn('Saved prompt unreadable', error)
      }
    </script>
    <script is:inline>
      // Presentation mode when the window holds the 1280x720 stage at 100% or more; flow mode otherwise.
      ;(function () {
        var STAGE_W = 1280, STAGE_H = 720, MIN_W = 700
        function fit() {
          var w = window.innerWidth, h = window.innerHeight
          var scale = Math.min(w / STAGE_W, h / STAGE_H)
          var stage = w >= MIN_W && scale >= 1
          var root = document.documentElement
          root.dataset.mode = stage ? 'stage' : 'flow'
          root.style.setProperty('--stage-scale', String(stage ? scale : 1))
        }
        fit()
        window.addEventListener('resize', fit)
      })()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
