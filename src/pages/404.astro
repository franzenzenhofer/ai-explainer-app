---
// Cloudflare Pages serves 404.html with status 404 for every unknown path.
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page not found - AI Explorer" description="This page does not exist.">
  <main class="mx-auto max-w-3xl px-4 py-16 text-base text-slate-900">
    <h1 class="mb-4 text-3xl font-bold">This page does not exist.</h1>
    <p class="mb-8">The address may be mistyped, or the page moved in the new version of AI Explorer.</p>
    <a class="inline-flex min-h-11 items-center rounded-lg bg-indigo-700 px-5 font-semibold text-white" href="/">Go to the start</a>
  </main>
</Layout>
